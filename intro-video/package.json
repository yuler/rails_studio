{
  "name": "rails-studio-intro",
  "private": true,
  "type": "module",
  "scripts": {
    "capture": "node capture/capture.mjs",
    "audio": "uv run --quiet --script audio/generate.py",
    "studio": "remotion studio src/index.ts",
    "render": "remotion render src/index.ts Intro out/intro.mp4 --codec h264 --crf 23 --audio-bitrate 128k --concurrency 3",
    "poster": "remotion still src/index.ts Intro ../assets/intro-poster.jpg --frame 760 --jpeg-quality 90"
  },
  "dependencies": {
    "@remotion/cli": "4.0.532",
    "@remotion/google-fonts": "4.0.532",
    "puppeteer-core": "^25.12.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "remotion": "4.0.532"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "typescript": "^5.6.0"
  }
}
