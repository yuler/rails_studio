<!DOCTYPE html>
<html lang="en" class="dark">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Rails Studio</title>
  <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><text y=%22.9em%22 font-size=%2290%22>💎</text></svg>">
  <script>
    window.__RAILS_STUDIO_CONFIG__ = {
      basePath: "<%= @base_path %>",
      apiBase: "<%= @base_path %>/api",
      railsVersion: "<%= Rails.version %>",
      rubyVersion: "<%= RUBY_VERSION %>",
      environment: "<%= Rails.env %>",
      readOnly: <%= RailsStudio.configuration.read_only? ? 'true' : 'false' %>
    };
  </script>
  <link rel="stylesheet" href="<%= @base_path %>/assets/index.css" />
  <script type="module" src="<%= @base_path %>/assets/index.js"></script>
</head>
<body class="bg-zinc-950 text-zinc-100 antialiased h-screen overflow-hidden select-none">
  <div id="root">
    <div class="flex items-center justify-center min-h-screen">
      <div class="text-center">
        <div class="inline-block animate-spin rounded-full h-8 w-8 border-t-2 border-b-2 border-red-500 mb-4"></div>
        <p class="text-zinc-400 font-mono text-sm">Loading Rails Studio...</p>
      </div>
    </div>
  </div>
</body>
</html>
